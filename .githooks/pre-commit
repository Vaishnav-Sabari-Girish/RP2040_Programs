#!/bin/sh
set -e

cd "$(git rev-parse --show-toplevel)"

echo "Checking for typos"
typos --exclude '**/patches/**'

echo "Formatting Rust code..."
find . -type d -name patches -prune -o -name "Cargo.toml" -print0 |
  xargs -0 -n1 -P4 cargo fmt --manifest-path

RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' | grep -v '/patches/' || true)
if [ -n "$RUST_FILES" ]; then
  echo "$RUST_FILES" | tr '\n' '\0' | xargs -0 -r git add
fi

echo "Fixing all markdown files..."

find . -type d -name patches -prune -o -type f -name "*.md" ! -name "CHANGELOG.md" -print0 |
  xargs -0 -r rumdl check --fix

find . -type d -name patches -prune -o -type f -name "*.md" ! -name "CHANGELOG.md" -print0 |
  xargs -0 -r git add

exit 0
